{
  "name": "meloria-shop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://OlhaKhodakivska.github.io/meloria-shop/",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/prerender-seo.js",
    "build:github": "tsc && VITE_BASE_PATH=/meloria-shop/ vite build && node scripts/prerender-seo.js",
    "import:prom": "node scripts/import-prom-feed.js",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "predeploy": "npm run build:github",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.61.8",
    "@supabase/supabase-js": "^2.108.2",
    "csvtojson": "^2.0.14",
    "lucide-react": "^1.21.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fast-xml-parser": "^5.9.3",
    "gh-pages": "^6.3.0",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
