# Public frontend configuration. VITE_ values are included in the browser bundle.
VITE_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_key

# Public payment details displayed to customers.
VITE_PAYMENT_RECIPIENT=your_payment_recipient
VITE_PAYMENT_CARD_NUMBER=your_payment_card_number
VITE_PAYMENT_IBAN=your_payment_iban

# Server-only Supabase configuration for the orders API.
# Never prefix a private key with VITE_ or commit its actual value.
SUPABASE_URL=https://your-project.supabase.co
# Accepts a Supabase secret key (sb_secret_...) or a legacy service_role key.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_server_secret_key

# Server-only Telegram notifications.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
